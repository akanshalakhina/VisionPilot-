# Database (SQLite file, created on first run)
DB_PATH=data/visionpilot.db

# Guardrail: the largest budget the agent may ever propose or run
MAX_TOTAL_BUDGET=10000

# Execution adapters: the sandbox is always on.
# The Meta adapter is OFF and not implemented. Leave this false.
META_ADAPTER_ENABLED=false

# Seed for the sandbox simulator
SIM_SEED=0

# LLM for the agent. Leave LLM_PROVIDER empty to use the offline rule-based planner.
# Providers with built-in URLs: openrouter, groq, gemini, ollama. For any other
# OpenAI-compatible service set LLM_BASE_URL. Use your OWN key (never someone else's)
# and a model name from your provider's current list.
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
AGENT_MAX_STEPS=6
UPLIFT_CUSTOMERS=20000

# Minimum share of the budget every ad keeps. The benchmark shows larger values cost clicks
# in stationary simulations (0.05 cost 4 to 8 points). See docs/benchmark.md before changing it.
EXPLORATION_FLOOR=0.01
